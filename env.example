# ============================================================
# Taiwan Defense Bot — 環境變數設定範本
# 使用方式：複製此檔案為 .env，填入實際值
#   cp .env.example .env
#
# ⚠️  .env 包含敏感資訊，不可上傳到 GitHub（已加入 .gitignore）
# ============================================================

# ------ Telegram ------
TELEGRAM_BOT_TOKEN=填入你的BotFather給的Token
TELEGRAM_CHANNEL_ID=@你的頻道ID

# ------ AIS 船隻追蹤 ------
# 申請：https://aisstream.io/
AISSTREAM_API_KEY=

# ------ Google Gemini（衛星影像分析 + AI 備援）------
# 申請：https://aistudio.google.com/
GEMINI_API_KEY=

# ------ Copernicus 衛星（可選，有免費額度）------
# 申請：https://dataspace.copernicus.eu/
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Gemini 模型（2.0-flash-lite 已下架）
GEMINI_MODEL=gemini-2.5-flash-lite

# ------ CARTO 底圖（可選，未填則用 Esri 免 key 底圖）------
# 申請：https://carto.com/basemaps/apikey/
CARTO_API_KEY=

# ------ Google Maps（衛星圖層，可選）------
# 申請：https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=

# ------ Ollama 本地 AI ------
# 預設 localhost，可改為遠端地址
OLLAMA_BASE_URL=http://localhost:11434
# 依顯卡選擇：無顯卡/6-8GB → gemma3:4b、12GB → gemma3:12b、24GB → gemma3:27b
OLLAMA_MODEL=gemma3:12b
# 單次呼叫逾時（秒）；排程發佈不在意速度，純 CPU 可調到 300 以上
OLLAMA_TIMEOUT=180

# ------ Web Dashboard ------
# 對外公開的網址（用於 /about 連結）
WEB_BASE_URL=http://127.0.0.1:5000
